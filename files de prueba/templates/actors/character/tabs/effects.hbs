<section class="tab effects actions-pane major sf-cyber-effects" data-group="primary" data-tab="effects">
    {{#if document.itemTypes.affliction}}
        <header class="cyber-header"><h3 class="neon-title">{{localize "PF2E.Item.Affliction.Plural"}}</h3></header>
        <ol class="effects-list directory-list item-list cyber-list">
            {{> (resolvePath "templates/actors/partials/effects.hbs") effects=document.itemTypes.affliction}}
        </ol>
    {{/if}}

    <header class="cyber-header"><h3 class="neon-title">{{localize "PF2E.ConditionsLabel"}}</h3></header>
    <ol class="effects-list directory-list item-list cyber-list">
        {{> (resolvePath "templates/actors/partials/effects.hbs") effects=document.conditions.active}}
    </ol>

    <header class="cyber-header"><h3 class="neon-title">{{localize "PF2E.EffectsLabel"}}</h3></header>
    <ol class="effects-list directory-list item-list cyber-list">
        {{> (resolvePath "templates/actors/partials/effects.hbs") effects=document.itemTypes.effect}}
    </ol>

    <header class="cyber-header" data-group-id="intercession">
        <h3 class="neon-title">{{localize "PF2E.Actor.Character.FeatSlot.DivineIntercessions"}}</h3>
        {{#if options.editable}}
            <div class="cyber-controls">
                <button type="button" class="cyber-btn" data-action="browse-feats" data-type="feat"><i class="fa-solid fa-fw fa-search neon-icon"></i>{{localize "PF2E.BrowseLabel"}}</button>
            </div>
        {{/if}}
    </header>
    <ol class="effects-list directory-list item-list cyber-list">
        {{#each document.divineIntercessions as |feat|}}
            <li class="item feat-item" data-item-id="{{feat.id}}">
                <div class="item-name">
                    <div class="feat-slot-title"></div>
                    <a class="item-image framed" data-action="item-to-chat">
                        <img src="{{feat.img}}"/>
                        <i class="fa-solid fa-message"></i>
                    </a>
                    <h4 class="name"><a data-action="toggle-summary">{{feat.name}}</a></h4>
                </div>
                {{#if @root.options.editable}}
                    <div class="item-controls">
                        <a data-action="edit-item" data-tooltip="PF2E.EditItemTitle"><i class="fa-solid fa-fw fa-edit"></i></a>
                        <a data-action="delete-item" data-tooltip="PF2E.DeleteItemTitle"><i class="fa-solid fa-fw fa-trash"></i></a>
                    </div>
                {{/if}}

                <div class="item-summary" hidden="hidden"></div>
            </li>
        {{/each}}
    </ol>
</section>
