<section class="tab feats feats-pane sf-cyber-feats" data-group="primary" data-tab="feats">
    {{#each feats as |section|}}
        <section class="feat-section major sf-cyber-feat-section" data-group-id="{{section.id}}">
            <header class="cyber-header">
                {{localize section.label}}
                {{#with section.customLimit}}
                    <span class="limit">
                        ({{localize label}} <input type="number"
                                                   name="{{concat "flags." @root.systemId ".featLimits." section.id}}"
                                                   value="{{section.limit}}" min="{{min}}" max="{{max}}" step="1" />)
                    </span>
                {{/with}}
                <div class="cyber-controls">
                    {{#if (eq section.id "bonus")}}
                        <button type="button" class="cyber-btn" data-action="create-feat">
                            <i class="fa-solid fa-fw fa-plus neon-icon"></i>{{localize "PF2E.Actor.Character.CreateFeat"}}
                        </button>
                    {{/if}}
                    <button
                        type="button"
                        class="cyber-btn"
                        data-action="browse-feats"
                        data-type="feat"
                    >
                        <i class="fa-solid fa-fw fa-search neon-icon"></i>{{localize "PF2E.BrowseLabel"}}
                    </button>
                </div>
            </header>
            <ol class="feats-list sf-cyber-feat-list" data-foundry-list>
                {{#each section.feats as |featSlot|}}
                    {{> (resolvePath "templates/actors/character/partials/feat-slot.hbs") featSlot=featSlot featFilter=section.featFilter}}
                {{/each}}
            </ol>
        </section>
    {{/each}}
</section>
